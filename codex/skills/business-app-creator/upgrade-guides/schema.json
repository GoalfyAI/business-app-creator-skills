{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oa.goalfyai.cn/schemas/goalfy-app-workbench/upgrade-guide.schema.json",
  "title": "智能应用升级指南文件头",
  "description": "upgrade-guides/<D编号>.md 开头 json 代码块的结构规则。文件名、大小及 replaces/withdraws/depends_on 的关系规则由 scripts/check-upgrade-guides.mjs 检查。",
  "type": "object",
  "required": ["did", "title", "impact", "applies_to", "already_done_check", "actions", "tests", "replaces", "withdraws"],
  "additionalProperties": false,
  "properties": {
    "did": { "$ref": "#/$defs/did" },
    "title": { "type": "string", "minLength": 1 },
    "impact": { "enum": ["none", "recommended", "required"] },
    "applies_to": {
      "type": "object",
      "required": ["layers", "when"],
      "additionalProperties": false,
      "properties": {
        "layers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["scaffold", "sdk", "skill", "mcp", "platform"] }
        },
        "when": { "type": "string", "minLength": 1 },
        "sdk_major": {
          "description": "适用的 SDK 主版本，不写按 5。4.1 版本线已冻结，不出新指南，所以只能取 5；以后有新主版本再加。候选脚本只返回与本次目标模板 SDK 主版本相同的指南。",
          "type": "integer",
          "enum": [5]
        }
      }
    },
    "already_done_check": { "type": "string", "minLength": 1 },
    "actions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "tests": { "type": "array", "items": { "$ref": "#/$defs/test" } },
    "replaces": { "$ref": "#/$defs/didList" },
    "withdraws": { "$ref": "#/$defs/didList" },
    "depends_on": { "$ref": "#/$defs/didList" }
  },
  "allOf": [
    {
      "$comment": "recommended 与 required 至少一条测试。",
      "if": { "required": ["impact"], "properties": { "impact": { "enum": ["recommended", "required"] } } },
      "then": { "properties": { "tests": { "type": "array", "minItems": 1 } } }
    }
  ],
  "$defs": {
    "did": { "type": "string", "pattern": "^D-[0-9]+$" },
    "didList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/did" } },
    "test": {
      "type": "object",
      "required": ["id", "kind", "expect"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["command", "check"] },
        "run": { "type": "string", "minLength": 1 },
        "how": { "type": "string", "minLength": 1 },
        "expect": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "$comment": "command 写 run，check 写 how。",
          "if": { "required": ["kind"], "properties": { "kind": { "const": "command" } } },
          "then": { "required": ["run"], "properties": { "run": true, "how": false } }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "check" } } },
          "then": { "required": ["how"], "properties": { "how": true, "run": false } }
        }
      ]
    }
  }
}
