{
  "description": "升级指南格式与关系规则正反样例。每个 dir 是一个独立的 upgrade-guides/ 目录；expect 为检查应报出的全部错误（file 按仓库 upgrade-guides/ 显示），空数组表示应通过。Studio 仓库 check 与制作 MCP 共用。",
  "cases": [
    {
      "name": "valid",
      "dir": "valid",
      "rule": "合法：required/recommended 带测试、replaces 链、只撤回 impact=none、depends_on、多 layers",
      "expect": []
    },
    {
      "name": "missing-did",
      "dir": "missing-did",
      "rule": "缺 did",
      "expect": [
        {
          "file": "upgrade-guides/D-9101.md",
          "field": "did",
          "code": "schema:required"
        }
      ]
    },
    {
      "name": "file-name-mismatch",
      "dir": "file-name-mismatch",
      "rule": "文件名与 did 不一致",
      "expect": [
        {
          "file": "upgrade-guides/D-9102.md",
          "field": "did",
          "code": "FILE_NAME"
        }
      ]
    },
    {
      "name": "impact-enum",
      "dir": "impact-enum",
      "rule": "impact 非枚举",
      "expect": [
        {
          "file": "upgrade-guides/D-9104.md",
          "field": "impact",
          "code": "schema:enum"
        }
      ]
    },
    {
      "name": "tests-required",
      "dir": "tests-required",
      "rule": "recommended/required 无测试",
      "expect": [
        {
          "file": "upgrade-guides/D-9105.md",
          "field": "tests",
          "code": "TESTS_REQUIRED"
        },
        {
          "file": "upgrade-guides/D-9106.md",
          "field": "tests",
          "code": "TESTS_REQUIRED"
        }
      ]
    },
    {
      "name": "duplicate-test-id",
      "dir": "duplicate-test-id",
      "rule": "测试 id 重复",
      "expect": [
        {
          "file": "upgrade-guides/D-9107.md",
          "field": "tests[1].id",
          "code": "DUPLICATE_TEST_ID"
        }
      ]
    },
    {
      "name": "too-large",
      "dir": "too-large",
      "rule": "单文件超 16KB",
      "expect": [
        {
          "file": "upgrade-guides/D-9108.md",
          "field": "(文件)",
          "code": "TOO_LARGE"
        }
      ]
    },
    {
      "name": "replaces-missing",
      "dir": "replaces-missing",
      "rule": "replaces 指向不存在的文件",
      "expect": [
        {
          "file": "upgrade-guides/D-9109.md",
          "field": "replaces[0]",
          "code": "REF_MISSING"
        }
      ]
    },
    {
      "name": "withdraws-self",
      "dir": "withdraws-self",
      "rule": "withdraws 指向自己",
      "expect": [
        {
          "file": "upgrade-guides/D-9110.md",
          "field": "withdraws[0]",
          "code": "REF_SELF"
        }
      ]
    },
    {
      "name": "replaces-cycle",
      "dir": "replaces-cycle",
      "rule": "互相 replaces 成环",
      "expect": [
        {
          "file": "upgrade-guides/D-9111.md",
          "field": "replaces[0]",
          "code": "REF_CYCLE"
        },
        {
          "file": "upgrade-guides/D-9112.md",
          "field": "replaces[0]",
          "code": "REF_CYCLE"
        }
      ]
    },
    {
      "name": "depends-on-missing",
      "dir": "depends-on-missing",
      "rule": "depends_on 指向不存在的文件",
      "expect": [
        {
          "file": "upgrade-guides/D-9113.md",
          "field": "depends_on[0]",
          "code": "REF_MISSING"
        }
      ]
    },
    {
      "name": "depends-on-cycle",
      "dir": "depends-on-cycle",
      "rule": "depends_on 成环（三份）",
      "expect": [
        {
          "file": "upgrade-guides/D-9114.md",
          "field": "depends_on[0]",
          "code": "REF_CYCLE"
        },
        {
          "file": "upgrade-guides/D-9115.md",
          "field": "depends_on[0]",
          "code": "REF_CYCLE"
        },
        {
          "file": "upgrade-guides/D-9116.md",
          "field": "depends_on[0]",
          "code": "REF_CYCLE"
        }
      ]
    },
    {
      "name": "layers-studio",
      "dir": "layers-studio",
      "rule": "layers 含 studio",
      "expect": [
        {
          "file": "upgrade-guides/D-9117.md",
          "field": "applies_to.layers[1]",
          "code": "LAYER_STUDIO"
        }
      ]
    },
    {
      "name": "withdraw-only-impact",
      "dir": "withdraw-only-impact",
      "rule": "只撤回的指南 impact 不是 none",
      "expect": [
        {
          "file": "upgrade-guides/D-9118.md",
          "field": "impact",
          "code": "WITHDRAW_ONLY_IMPACT"
        }
      ]
    },
    {
      "name": "double-succession",
      "dir": "double-succession",
      "rule": "同一 D 被两份指南 replaces/withdraws",
      "expect": [
        {
          "file": "upgrade-guides/D-9121.md",
          "field": "replaces[0]",
          "code": "DOUBLE_SUCCESSION"
        },
        {
          "file": "upgrade-guides/D-9122.md",
          "field": "withdraws[0]",
          "code": "DOUBLE_SUCCESSION"
        }
      ]
    },
    {
      "name": "header-not-json-fence",
      "dir": "header-not-json-fence",
      "rule": "文件头不是 json 代码块",
      "expect": [
        {
          "file": "upgrade-guides/D-9123.md",
          "field": "(文件头)",
          "code": "HEADER"
        }
      ]
    },
    {
      "name": "test-run-how",
      "dir": "test-run-how",
      "rule": "kind=command 缺 run",
      "expect": [
        {
          "file": "upgrade-guides/D-9124.md",
          "field": "tests[0].run",
          "code": "schema:required"
        },
        {
          "file": "upgrade-guides/D-9124.md",
          "field": "tests[0].how",
          "code": "schema:false"
        }
      ]
    },
    {
      "name": "impact-none-scope",
      "dir": "impact-none-scope",
      "rule": "impact=none 却要求应用修改",
      "expect": [
        {
          "file": "upgrade-guides/D-9125.md",
          "field": "impact",
          "code": "IMPACT_NONE_SCOPE"
        }
      ]
    }
  ]
}
